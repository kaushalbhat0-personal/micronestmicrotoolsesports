# MicroNest Esports — Environment Variables
# Copy to .env.local and fill values. Never commit secrets.
# Only the new application's required variable names are listed here.

# Public (browser-exposed) — safe for NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (never expose via NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
