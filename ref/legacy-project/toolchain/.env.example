# ──────────────────────────────────────────────────────────────
# MicroNest — Environment Variables
# Copy to .env.local and fill values. Never commit secrets.
# ──────────────────────────────────────────────────────────────

# ── Public (browser-exposed) ─────────────────────────────────
# Required — Supabase project URL and anon key (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MicroNest

# ── Server-only (never expose via NEXT_PUBLIC_) ─────────────
# Required — duplicated for serverSchema fallback
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Required — service_role key — server-only, never in browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Optional — cron authentication (generate: openssl rand -hex 32)
CRON_SECRET=change-me-to-a-random-32-char-secret

# ── Billing providers — optional until implemented ───────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_SPONSOR_SENTINEL=price_...
STRIPE_PRICE_ID_ALL_ACCESS=price_...

RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# Dodo Payments — V1 one-time checkout per billing period (no auto-renewing subscriptions).
# Test key works only with DODO_PAYMENTS_ENVIRONMENT=test_mode; live key only with live_mode.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/billing/return
# Dodo product IDs — one per plan slug (create in Dodo dashboard per environment).
# Server-only. Missing ID for a purchased plan fails checkout closed.
DODO_PRODUCT_SPONSORSHIP_TRACKING_MONTHLY=
DODO_PRODUCT_SPONSORSHIP_TRACKING_YEARLY=
# International V1 — Sponsorship Tracking USD products only. No other tool has
# a USD product in V1. Missing ID for a purchased plan fails checkout closed.
DODO_PRODUCT_SPONSORSHIP_TRACKING_MONTHLY_USD=
DODO_PRODUCT_SPONSORSHIP_TRACKING_YEARLY_USD=
DODO_PRODUCT_PRIZE_POOL_SPLITTER_MONTHLY=
DODO_PRODUCT_PRIZE_POOL_SPLITTER_YEARLY=
DODO_PRODUCT_DRAFT_BAN_MONTHLY=
DODO_PRODUCT_DRAFT_BAN_YEARLY=
DODO_PRODUCT_TIE_BREAKER_MONTHLY=
DODO_PRODUCT_TIE_BREAKER_YEARLY=
DODO_PRODUCT_PRIZE_PAYOUT_TRACKER_MONTHLY=
DODO_PRODUCT_PRIZE_PAYOUT_TRACKER_YEARLY=
DODO_PRODUCT_ALL_ACCESS_MONTHLY=
DODO_PRODUCT_ALL_ACCESS_YEARLY=

# ── Integrations — optional ──────────────────────────────────
TWITCH_CLIENT_ID=...
TWITCH_CLIENT_SECRET=...
TWITCH_EVENTSUB_SECRET=change-me-to-a-random-secret-32-chars
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_API_KEY=...
KICK_CLIENT_ID=...
KICK_CLIENT_SECRET=...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── OAuth redirect URIs (provider app settings — no secrets here) ──
# Register each callback URL below in the matching provider developer
# console, using your deployed app origin (NEXT_PUBLIC_APP_URL):
#   Twitch:  {APP_URL}/api/auth/twitch/callback
#   YouTube: {APP_URL}/api/auth/youtube/callback
#   Kick:    {APP_URL}/api/auth/kick/callback
# Example: https://app.example.com/api/auth/twitch/callback
# The app builds these via getOAuthCallbackUrl(); never trust Host headers.

# ── Security — required in production ────────────────────────
# 32-byte base64 (44 chars) or 64-char hex for encrypting org provider credentials
# Generate: openssl rand -base64 32  (or: openssl rand -hex 32)
# Never commit real value. Must be set in production (Vercel env).
# Development/test fallback is zero-key and MUST NOT be used in production.
CREDENTIALS_ENCRYPTION_KEY=

# ── Supabase local dev (if using supabase CLI) ───────────────
# SUPABASE_PROJECT_ID=your-project-id
